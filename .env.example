# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID чата, который бот защищает.
# Узнать можно так: добавь бота в чат, потом открой
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
# Значение chat.id (отрицательное для групп) — сюда.
CHAT_ID=-1001234567890

# Telegram ID админов (можно несколько через запятую).
# Свой ID можно узнать у @userinfobot или @RawDataBot.
ADMIN_IDS=123456789

# --- Настройки антиспама (можно менять под себя) ---

# Минимальный возраст аккаунта в ДНЯХ.
# Если у новичка аккаунт моложе — бан сразу.
MIN_ACCOUNT_AGE_DAYS=7

# Сколько сообщений можно отправить за FLOOD_WINDOW_SECONDS
FLOOD_MAX_MESSAGES=5
FLOOD_WINDOW_SECONDS=10

# Через сколько секунд кикнуть новичка, если он не нажал "Я не робот"
CAPTCHA_TIMEOUT_SECONDS=120

# Список запрещённых паттернов (regex). Паттерны разделяются "||" (двойной пайп).
# Каждый паттерн — самостоятельный regex. Флаг (?i) делает его регистронезависимым.
# При совпадении любого паттерна — сообщение удаляется.
# Примеры того, что часто спамят в AI-чатах:
BANNED_PATTERNS=(?i)заработ[и]?к||(?i)пассивн[ыи]й доход||(?i)казино||(?i)крипто||(?i)сигналы||(?i)1xbet||(?i)закрыт[ыи]й клуб||(?i)инфокурс||(?i)нейросеть заменит||(?i)пирамида||(?i)каппер||(?i)binance||(?i)bybit||(?i)okx||(?i)mlm||(?i)ставк[аи]||http(s)?://(?!t\.me/asvet_probot)

# Путь к SQLite-базе (относительно корня проекта)
DB_PATH=./data/bot.db

# --- ML антиспам (опционально) ---
# Включает/выключает нейросетевой фильтр токсичности/спама.
# При выключении бот работает только по regex-паттернам (BANNED_PATTERNS).
ML_ENABLED=true

# Путь к каталогу с моделью и токенизатором (создаётся scripts/export_onnx.py
# или автоматически при сборке Docker-образа).
ML_MODEL_DIR=./models/rubert-tiny-toxicity

# Порог вероятности «плохой» метки. 0.6 = довольно мягко (ловит больше).
# Поднять до 0.8 — будет реже ошибаться, но и больше пропускать.
ML_THRESHOLD=0.6

# Какие метки модели считать «плохими» (через запятую).
# По умолчанию пусто — фильтр сам берёт все, кроме non-toxic/neutral.
# Для тонкой настройки: ML_BAD_LABELS=insult,threat,dangerous
# ML_BAD_LABELS=
